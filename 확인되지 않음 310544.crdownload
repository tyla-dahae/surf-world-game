/* SURF WORLD 서비스 워커: 게임 파일은 인터넷에서 최신 걸 먼저 받고(최대 3초), 느리거나 끊기면 저장해 둔 걸로 열어요 */
const CACHE='surf-world-v7';
const SHELL=['./','./index.html','./manifest.webmanifest','./icon-192.png','./icon-512.png','./apple-touch-icon.png'];
self.addEventListener('install',e=>{e.waitUntil(caches.open(CACHE).then(c=>c.addAll(SHELL)).catch(()=>{}));self.skipWaiting()});
self.addEventListener('activate',e=>{e.waitUntil(caches.keys().then(ks=>Promise.all(ks.filter(k=>k!==CACHE).map(k=>caches.delete(k)))).then(()=>self.clients.claim()))});
self.addEventListener('fetch',e=>{const r=e.request;if(r.method!=='GET')return;const u=new URL(r.url);
  const same=u.origin===self.location.origin,lib=/cdnjs\.cloudflare\.com|cdn\.jsdelivr\.net|fonts\.(googleapis|gstatic)\.com/.test(u.host);
  if(!same&&!lib)return;
  if(lib){e.respondWith(caches.open(CACHE).then(c=>c.match(r).then(hit=>hit||fetch(r).then(res=>{if(res&&(res.ok||res.type==='opaque'))c.put(r,res.clone());return res}))));return}
  const key=(r.mode==='navigate'||u.pathname.endsWith('/')||u.pathname.endsWith('/index.html'))?'./index.html':r;
  e.respondWith(caches.open(CACHE).then(c=>{
    const net=fetch(r,{cache:'no-store'}).then(res=>{if(res&&res.ok)c.put(key,res.clone());return res});
    const slow=new Promise(ok=>setTimeout(ok,3000)).then(()=>c.match(key,{ignoreSearch:true}));
    return Promise.race([net.catch(()=>c.match(key,{ignoreSearch:true})),slow.then(h=>h||net)]).then(res=>res||net)}))});
